{
    "$schema" : "https://json-schema.org/draft/2020-12/schema ",
    "título" : "Cambio de SDD" ,
    "tipo" : "objeto" ,
    "requerido" : [ "id" , "título" , "estado" , "requisitos" ],
    "propiedades" : {
      "id" : { "type" : "string" , "minLength" : 3 },
      "título" : { "tipo" : "cadena" , "longitud minima" : 5 },
      "estado" : {
        "tipo" : "cadena",
        "enum" : [ "borrador" , "listo" , "en progreso" , "validado" , "archivado" ]
    },

    "requisitos" : {
      "tipo" : "matriz",
        "minItems" : 1,
        "elementos" : {
           "tipo" : "objeto",
           "requerido" : [ "id" , "declaración" , "criterios de aceptación" ],
           "propiedades" : {
             "id" : { "type" : "string" },
             "declaración" : { "tipo" : "cadena" },
             "criterios de aceptación" : {
               "tipo" : "matriz" ,
	             "minItems" : 1,
               "items" : {"type" : "string"}
              }
            },
          "additionalProperties" : false
        }
      }
    },
    "additionalProperties" : false
}